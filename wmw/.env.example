STACK_NAME=wmw
# Porta no HOST (mapeamento host:container). Traefik/Dokploy usa a porta *dentro* do container (80).
NGINX_HTTP_PORT=8080

# Dominio publico (Dokploy / DNS).
SERVER_NAME=wmw.motasa.com.br

# Upstream interno (HTTP na rede privada).
APP_UPSTREAM_SCHEME=http
APP_UPSTREAM_HOST=10.250.250.3
APP_UPSTREAM_PORT=8090

# Context path da aplicacao (JSF). Use barra no fim: requisicao /vai para /motasa/...
# Deixe vazio se a app responde na raiz.
APP_UPSTREAM_PREFIX=/motasa/
