server {
    listen 80;
    server_name ${SERVER_NAME};

    access_log /dev/stdout combined;
    error_log /dev/stderr notice;

    # Permite upload maior para aplicações com anexos.
    client_max_body_size 50m;

    # Intercepta erros do upstream para exibir página customizada.
    proxy_intercept_errors on;
    error_page 400 401 403 404 405 408 410 429 500 502 503 504 /error.html;

    location = /error.html {
        root /usr/share/nginx/html;
        internal;
    }

    location / {
        # APP_UPSTREAM_PREFIX vazio: repassa URI inteira. Ex.: /motasa/ repassa com prefixo cortado e URI anexada.
        proxy_pass ${APP_UPSTREAM_SCHEME}://${APP_UPSTREAM_HOST}:${APP_UPSTREAM_PORT}${APP_UPSTREAM_PREFIX};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $motasa_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_redirect off;

        proxy_connect_timeout ${PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${PROXY_READ_TIMEOUT};
        proxy_send_timeout ${PROXY_SEND_TIMEOUT};
    }
}
